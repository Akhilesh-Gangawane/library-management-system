{
  "info": {
    "_postman_id": "library-mgmt-sys-postman-collection",
    "name": "Library Management System API",
    "description": "Comprehensive API collection for Library Management System covering User, Book, Borrowing, and Admin workflows with JWT authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Alice Smith\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"alice@123\",\n  \"phone\": \"+91-9876500001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Register a new regular user in the library system."
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.access_token) {",
                  "    pm.collectionVariables.set('userToken', jsonData.data.access_token);",
                  "    console.log('User token captured successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@email.com\",\n  \"password\": \"user@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticate as regular user (user@email.com / user@123) and receive JWT access token."
          }
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.access_token) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.data.access_token);",
                  "    console.log('Admin token captured successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@college.edu\",\n  \"password\": \"admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticate as administrator (admin@college.edu / admin@123) and receive JWT access token."
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "profile"]
            },
            "description": "Retrieve profile of the currently authenticated user."
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"John Doe Updated\",\n  \"phone\": \"+91-9988776655\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "profile"]
            },
            "description": "Update personal profile information for authenticated user."
          }
        }
      ]
    },
    {
      "name": "2. Books (Browsing & Searching)",
      "item": [
        {
          "name": "List All Books (Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books?page=1&per_page=12",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "12"
                }
              ]
            },
            "description": "List all books with pagination metadata."
          }
        },
        {
          "name": "Search Books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books?search=Clean",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                {
                  "key": "search",
                  "value": "Clean"
                }
              ]
            },
            "description": "Search books by title, ISBN, or publisher."
          }
        },
        {
          "name": "Filter Books by Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books?category_id=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                {
                  "key": "category_id",
                  "value": "1"
                }
              ]
            },
            "description": "Filter books by specific category ID."
          }
        },
        {
          "name": "Filter Books Available Only",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books?available_only=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                {
                  "key": "available_only",
                  "value": "true"
                }
              ]
            },
            "description": "Filter books having copies available for loan."
          }
        },
        {
          "name": "Get Book by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "1"]
            },
            "description": "Retrieve comprehensive details for a single book."
          }
        },
        {
          "name": "List All Authors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/authors",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "authors"]
            },
            "description": "Retrieve list of all book authors."
          }
        },
        {
          "name": "List All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "categories"]
            },
            "description": "Retrieve list of all book categories."
          }
        }
      ]
    },
    {
      "name": "3. Borrowings (User)",
      "item": [
        {
          "name": "Borrow Book",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"book_id\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/borrowings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "borrowings"]
            },
            "description": "Borrow a book copy (decrements available copies, records loan due date in 14 days)."
          }
        },
        {
          "name": "Return Borrowed Book",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/borrowings/1/return",
              "host": ["{{baseUrl}}"],
              "path": ["api", "borrowings", "1", "return"]
            },
            "description": "Return a borrowed book (marks returned and increments available copies)."
          }
        },
        {
          "name": "Get My Borrowing History",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/borrowings/my-history?page=1&per_page=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "borrowings", "my-history"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "10"
                }
              ]
            },
            "description": "Retrieve current and past borrowing records for the logged-in user."
          }
        }
      ]
    },
    {
      "name": "4. Admin Operations",
      "item": [
        {
          "name": "Add Book",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Designing Data-Intensive Applications\",\n  \"isbn\": \"9781449373320\",\n  \"description\": \"The definitive guide to distributed data systems, storage engines, and reliability.\",\n  \"publisher\": \"O'Reilly Media\",\n  \"published_year\": 2017,\n  \"total_copies\": 3,\n  \"author_id\": 1,\n  \"category_id\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "books"]
            },
            "description": "Add a new book to the library catalog. Admin only."
          }
        },
        {
          "name": "Update Book",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"total_copies\": 5,\n  \"available_copies\": 5,\n  \"is_available\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/books/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "books", "1"]
            },
            "description": "Update book details or inventory availability. Admin only."
          }
        },
        {
          "name": "Delete Book",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/books/6",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "books", "6"]
            },
            "description": "Delete a book from catalog. Admin only."
          }
        },
        {
          "name": "Add Author",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Martin Kleppmann\",\n  \"bio\": \"Researcher in distributed systems and author of Designing Data-Intensive Applications.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/authors",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "authors"]
            },
            "description": "Add a new author. Admin only."
          }
        },
        {
          "name": "Add Category",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cloud Computing & DevOps\",\n  \"description\": \"Containerization, Kubernetes, CI/CD, and infrastructure.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "categories"]
            },
            "description": "Add a new category. Admin only."
          }
        },
        {
          "name": "View Users",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users"]
            },
            "description": "View all registered patrons and system users. Admin only."
          }
        },
        {
          "name": "View All Borrowing Records",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/borrowings?page=1&per_page=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "borrowings"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "10"
                }
              ]
            },
            "description": "View borrowing records across all patrons with pagination. Admin only."
          }
        },
        {
          "name": "Filter Borrowing Records by Status",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/borrowings?status=borrowed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "borrowings"],
              "query": [
                {
                  "key": "status",
                  "value": "borrowed"
                }
              ]
            },
            "description": "Filter borrowing records by status ('borrowed' or 'returned'). Admin only."
          }
        }
      ]
    }
  ]
}
