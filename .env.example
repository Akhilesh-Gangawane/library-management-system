# ===========================================
# Library Management System - Environment Config Template
# Copy this file to .env and adjust values as needed.
# ===========================================

# Application Settings
APP_NAME=Library Management System
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database Configuration
# SQLite (default for local development):
DATABASE_URL=sqlite:///./library.db
# MySQL / MariaDB via PyMySQL:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/library_db?charset=utf8mb4

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-in-production-2024
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin Default Credentials
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=admin@123

# Default User Credentials (for seeding)
DEFAULT_USER_EMAIL=user@email.com
DEFAULT_USER_PASSWORD=user@123

# CORS Settings
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
